# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
.idea/
.DS_Store

# SwiftPM build products and local macOS application staging directories.
macos/.build/
macos/.swiftpm/
dist/.app-staging/

# Config file
config.toml

# HITSZ/aTrust runtime credentials and raw diagnostic captures. Keep only
# redacted documentation and synthetic test fixtures in the repository.
hitsz-client-data.json
*-client-data.json
client_data*.json
otpsecret
*.otpsecret
*.otp-secret
*.otp
*.har
*.pcap
*.pcapng
atrust*.txt
aTrust*.txt

# Per-session Shadowrocket output generated from the authenticated resource list.
Shadowrocket-hitsz-connect-*.conf

# Encrypted HITSZ Connect profiles are machine-bound credentials. They live
# outside the repository by default, under ~/Documents/hitsz-connect/.
*.hcenc

# Android build artifacts generated from the gomobile binding.
android/app/libs/*.aar
android/app/libs/*-sources.jar
android/app/build/
android/.gradle/
android/build/
android/local.properties
android/local-release.keystore
android/local-signing.properties

# Keep only explicitly selected Android distribution artifacts.
dist/android/*.aar
