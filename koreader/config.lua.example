-- Copy this file to config.lua and edit it before uploading the plugin.
-- Keep config.lua private: it contains your HITSZ password and, for OTP,
-- the long-lived authenticator seed.
return {
    profile = "hitsz",
    server_address = "trust.hitsz.edu.cn",
    server_port = 443,
    username = "REPLACE_WITH_STUDENT_ID_OR_PHONE",
    password = "REPLACE_WITH_HITSZ_PASSWORD",

    -- Exactly one of: "app", "sms", or "otp".
    mfa_method = "app",
    -- Required only for mfa_method = "otp". Base32 or otpauth:// URI.
    mfa_otp_secret = "",

    -- The bridge never mutates Kindle system DNS. These loopback listeners
    -- are the endpoints that other Kindle applications can use.
    socks_bind = "127.0.0.1:1080",
    http_bind = "127.0.0.1:1081",
    dns_relay_bind = "127.0.0.1:53535",
    hitsz_dns_server = "10.248.98.30",

    remember_sso = true,
    remember_mfa = true,
    update_best_nodes_interval = 300,

    -- Usually unnecessary. If Kindle has no usable system CA bundle, point
    -- this at KOReader's CA certificate file with an absolute Kindle path.
    -- ca_cert_file = "/mnt/us/koreader/data/cacert.pem",
}
